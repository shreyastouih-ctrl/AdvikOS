#!/bin/sh
# ==============================================================================
# AdvikOS - Low-RAM Waydroid Initializer
# Downloads minimal LineageOS image without heavy GApps
# ==============================================================================

echo "========================================================"
echo "          AdvikOS - Android (Waydroid) Setup           "
echo "========================================================"
echo "Configuring minimal Android container for 1 GB RAM..."
echo ""

# Ensure binder modules are loaded
sudo modprobe binder_linux || true
sudo modprobe ashmem_linux || true

# Install Waydroid from official source if needed
if ! command -v waydroid &>/dev/null; then
    echo ">> Installing Waydroid engine from official source..."
    rm -rf /tmp/waydroid
    git clone --depth 1 https://github.com/waydroid/waydroid.git /tmp/waydroid
    cd /tmp/waydroid
    sudo make install
    cd -
fi

# Initialize Waydroid with minimal image (NO Google Play Services to save 400MB RAM)
echo ">> Downloading minimal Android system image..."
sudo waydroid init -s VANILLA

# Enable & restart Waydroid container service
echo ">> Starting Waydroid container service..."
sudo systemctl enable --now waydroid-container.service
sudo systemctl restart waydroid-container.service

echo ""
echo "========================================================"
echo "  Success! Android is ready. You can now launch it from "
echo "  the AdvikOS menu or run 'waydroid show-full-ui'.       "
echo "========================================================"
read -p "Press Enter to exit..."
